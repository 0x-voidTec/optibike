<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.google.ar.sceneform, com.google.ar.sceneform.ux, com.google.ar.sceneform.rendering, com.google.ar.sceneform.assets" />

    <application
        android:name=".OptiBikeApp"
        android:allowBackup="true"
        android:icon="@drawable/optibike_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/optibike_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.OptiBike"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OptiBike">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <uses-permission android:name="android.permission.CAMERA" />
</manifest>
